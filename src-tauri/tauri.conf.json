{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "M808 Control",
  "version": "1.2.0",
  "identifier": "io.github.m808control",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Configurador do mouse Redragon M808-KS",
    "category": "Utility",
    "license": "MIT",
    "publisher": "M808 Control contributors",
    "copyright": "MIT License",
    "longDescription": "Configurador open source para o mouse Redragon Storm Pro (M808-KS): DPI, botões, iluminação e polling rate, com ícone na bandeja.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true,
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/udev/rules.d/70-m808-control.rules": "../packaging/linux/70-m808-control.rules"
        },
        "depends": [
          "libayatana-appindicator3-1"
        ]
      },
      "rpm": {
        "files": {
          "/usr/lib/udev/rules.d/70-m808-control.rules": "../packaging/linux/70-m808-control.rules"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRBNDRCRkYyOTcwNzU1NkEKUldScVZRZVg4cjlFU3ZKbk9ONHN0dW9HcW82RGNpOG5YVWwyVWg5Q01YVlFUYTQ2ZlpMa2RmM0YK",
      "endpoints": [
        "https://github.com/ivanmurja/m808-control/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}